configuration {
    modi: "drun,run";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    hover-select: true;
}

* {
    font: "JetBrainsMono Nerd Font 12";

    bg:  #15152F;
    bg-alt: #040D16;
    bg-selected: #B110F0;
    fg: #cdd6f4;
    selected: #89b4fa;

    border-color:#B110F0 ;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 35%;
    border: 2px;
    border-radius: 18px;
    border-color: @border-color;
    background-color: @bg;
    location: center;
    anchor: center;
}

mainbox {
    children: [inputbar, listview];
    spacing: 14px;
    padding: 14px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px;
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search...";
    text-color:  #E9EBEC;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 8px;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 12px;
    background-color: #64727D;
}

element selected.normal {
    background-color: @bg-selected;
    text-color: #ffffff;
}
